{
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": ["^react$", "^next(/.*)?$", "^framer-motion$", "^lucide-react$", "^@/", "^[./]"],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100
}
